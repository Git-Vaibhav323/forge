APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# --- Database ---
# Local Docker Postgres:
# DATABASE_URL=postgresql+psycopg://forgedata:forgedata@localhost:5433/forgedata
# Supabase — do not put % encodings in DATABASE_URL. Use these parts instead:
# Session pooler (IPv4). Direct db.PROJECT.supabase.co is IPv6 and is slow on Windows.
POSTGRES_HOST=aws-0-YOUR_REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.YOUR_REF
POSTGRES_PASSWORD="your-raw-password"
POSTGRES_SSLMODE=require

PROJECT_SERVICE_URL=http://localhost:8001
FILE_SERVICE_URL=http://localhost:8002
QUESTION_SERVICE_URL=http://localhost:8003

# --- Object storage ---
# Local MinIO:
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=forgedata
OBJECT_STORAGE_SECRET_KEY=forgedata
OBJECT_STORAGE_BUCKET=forgedata
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_REGION=us-east-1
# Supabase Storage (S3):
# OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# OBJECT_STORAGE_ACCESS_KEY=your_s3_access_key
# OBJECT_STORAGE_SECRET_KEY=your_s3_secret_key
# OBJECT_STORAGE_BUCKET=forgedata
# OBJECT_STORAGE_SECURE=true
# OBJECT_STORAGE_REGION=ap-south-1

# REDIS_URL=redis://localhost:6379
# LLM_API_KEY=
