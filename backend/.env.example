APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# --- Database ---
# Local Docker Postgres:
# DATABASE_URL=postgresql+psycopg://forgedata:forgedata@localhost:5433/forgedata
# Supabase — do not put % encodings in DATABASE_URL. Use these parts instead:
# Session pooler (IPv4). Direct db.PROJECT.supabase.co is IPv6 and is slow on Windows.
POSTGRES_HOST=aws-0-YOUR_REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.YOUR_REF
POSTGRES_PASSWORD="your-raw-password"
POSTGRES_SSLMODE=require

PROJECT_SERVICE_URL=http://localhost:8001
FILE_SERVICE_URL=http://localhost:8002
QUESTION_SERVICE_URL=http://localhost:8003
EVIDENCE_SERVICE_URL=http://localhost:8004
REVIEW_SERVICE_URL=http://localhost:8005
# Internal only — not proxied by the gateway; generation-service (M8) calls it.
RELATIONSHIP_SERVICE_URL=http://localhost:8006
# Internal only — evidence-service reads images via shared/ocr.py directly.
VISION_SERVICE_URL=http://localhost:8007
GENERATION_SERVICE_URL=http://localhost:8008

# --- Object storage ---
# Local MinIO:
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=forgedata
OBJECT_STORAGE_SECRET_KEY=forgedata
OBJECT_STORAGE_BUCKET=forgedata
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_REGION=us-east-1
# Supabase Storage (S3):
# OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# OBJECT_STORAGE_ACCESS_KEY=your_s3_access_key
# OBJECT_STORAGE_SECRET_KEY=your_s3_secret_key
# OBJECT_STORAGE_BUCKET=forgedata
# OBJECT_STORAGE_SECURE=true
# OBJECT_STORAGE_REGION=ap-south-1

# REDIS_URL=redis://localhost:6379

# --- Hybrid question engine (optional LLM ranking) ---
# Recommended FREE provider: Google Gemini — https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-3.1-flash-lite
# Also free on AI Studio: gemini-3.6-flash (smarter), gemini-flash-latest (auto-updates alias)
#
# Alternative FREE provider: Groq — https://console.groq.com/
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key
# LLM_MODEL=llama-3.1-8b-instant
#
# Disable LLM (rules + evidence pre-fill still active):
# LLM_PROVIDER=off
# When enabled, LLM also powers Print-time solution generation (questions + evidence + PDF/OCR text).
# LLM_API_KEY=
# LLM_MODEL=

# --- Nameplate / image OCR (M7) ---
# Default OFF. Images are stored and listed but read no facts — the stack runs
# on a clean machine with no system binaries. Turning OCR on never changes the
# rules: a photo-only value lands as `unverified` until a second source agrees.
OCR_PROVIDER=off
#
# Local tesseract (needs the tesseract binary + `pip install pytesseract pillow`):
# OCR_PROVIDER=tesseract
# Windows: point at the installed binary if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# OCR.space cloud API (https://ocr.space/ocrapi — free tier key starts with K):
# OCR_PROVIDER=ocrspace
# OCR_API_KEY=your_ocrspace_api_key
#
# Your own OCR HTTP API (POST multipart `file`; returns {"text"} or {"pages"}):
# OCR_PROVIDER=custom
# OCR_API_URL=https://example.com/ocr
# OCR_API_KEY=

# --- Web page ingest (Evidence: paste/fetch URL as a citeable document) ---
# Default is direct HTTP fetch — no API keys required.
# WEB_FETCH_PROVIDER=direct
#
# Apify (NOT wired yet — do not set apify until integration ships):
# WEB_FETCH_PROVIDER=apify
# APIFY_API_TOKEN=
# APIFY_ACTOR_ID=
#
# Custom scraper API (optional):
# WEB_FETCH_PROVIDER=custom
# WEB_FETCH_API_URL=
# WEB_FETCH_API_KEY=
